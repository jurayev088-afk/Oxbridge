PORT=3001

# PostgreSQL — ma'lumotlar shu yerda saqlanadi (server qayta ishga tushsa ham yo'qolmaydi)
# Docker: npm run db:up
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/crm_demo

# Telegram bot (@BotFather — Oxbridge Academy)
# Ota-ona botda /start + telefon ulashadi — Chat ID kerak emas
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=oxbridgeacademy_bot
# Render production da true. Local dev da Render bilan bir xil token bo'lsa false qiling
TELEGRAM_POLLING=true

# Eskiz.uz SMS (ixtiyoriy)
ESKIZ_EMAIL=your@email.uz
ESKIZ_PASSWORD=your_password
ESKIZ_FROM=4546

# Xavfsizlik (production da majburiy)
# Kamida 32 belgili tasodifiy satr: openssl rand -base64 32
AUTH_SECRET=
# Birinchi marta login yaratishda (DB da login bo'lmasa) kamida 12 belgi
DIRECTOR_PASSWORD=
ADMIN_PASSWORD=
# Telegram webhook ishlatilsa (polling o'rniga)
TELEGRAM_WEBHOOK_SECRET=
# Qo'shimcha CORS manbalar (vergul bilan)
# CORS_ORIGINS=https://example.com
